---
import '../styles/global.css';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORY_GROUPS } from '../consts';
import { websiteSchema, organizationSchema } from '../lib/schema';
import TrackingAndAds from '../components/TrackingAndAds.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  noAnalytics?: boolean;
  jsonLd?: object | object[];
  lang?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage,
  ogType = 'website',
  noindex = false,
  noAnalytics = false,
  jsonLd,
  lang = 'ko',
  alternates = [],
} = Astro.props;

// 페이지별 JSON-LD 정규화 (사이트 전역 WebSite/Organization 은 항상 1회 렌더)
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);

// 방문자 분석·검색 노출 — 값 없으면 렌더 안 함(하드코딩 금지, 애드센스와 동일한 PUBLIC_* 규약)
const GSC = import.meta.env.PUBLIC_GSC_VERIFICATION;    // 서치콘솔 HTML 태그 확인 토큰
const ADSENSE_ACCOUNT = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-9440589549659043';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- 구글 서치콘솔 소유확인 (PUBLIC_GSC_VERIFICATION 있을 때만) -->
    {GSC && <meta name="google-site-verification" content={GSC} />}
    <meta name="google-adsense-account" content={ADSENSE_ACCOUNT} />

    <!-- 로컬·웹드라이버·자동화 점검 방문은 분석과 광고를 모두 건너뜁니다. -->
    {!noAnalytics && <TrackingAndAds />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <!-- 구조화 데이터: 사이트 전역(WebSite+SearchAction / Organization) + 페이지별 -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema())} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema())} />
    {pageSchemas.map((s) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />
    ))}


    <!-- 테마 적용: FOUC 방지 위해 head에서 즉시 실행. 기본 = 라이트(첫 방문 화이트), 선택은 쿠키로 기억 -->
    <script is:inline>
      const applyTheme = () => {
        const m = document.cookie.match(/(?:^|;\s*)theme=(dark|light)/);
        const theme = m ? m[1] : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');
      };
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900 antialiased transition-colors dark:bg-surface-950 dark:text-gray-100">
    <!-- 읽기 진행바 -->
    <div id="read-progress" class="fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-accent-500 transition-transform duration-100"></div>
    <header class="sticky top-0 z-40 border-b border-gray-200/70 bg-gray-50/80 backdrop-blur dark:border-white/10 dark:bg-surface-950/80">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3.5">
        <a href={lang === 'ko' ? '/' : `/${lang}/`} class="group flex shrink-0 items-center gap-2 text-lg font-bold tracking-tight">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-accent-500 transition-transform group-hover:scale-125"></span>
          {SITE_TITLE}
        </a>

        <!-- 데스크톱 네비 (lg 이상) -->
        <nav class="hidden items-center gap-1 text-sm lg:flex">
          <a href="/calc/" class="rounded-full px-2.5 py-1.5 font-semibold text-accent-700 transition-colors hover:bg-accent-50 dark:text-accent-300 dark:hover:bg-white/10">계산기</a>
          <span class="mx-1.5 h-4 w-px bg-gray-300 dark:bg-white/15" aria-hidden="true"></span>
          {CATEGORY_GROUPS.map((group, i) => (
            <>
              {i > 0 && <span class="mx-1.5 h-4 w-px bg-gray-300 dark:bg-white/15" aria-hidden="true"></span>}
              <span class="px-1 text-xs font-bold uppercase tracking-wide text-accent-600 dark:text-accent-400">{group.name}</span>
              {Object.entries(group.categories).map(([slug, name]) => (
                <a
                  href={`/category/${slug}/`}
                  class="rounded-full px-2.5 py-1.5 text-gray-600 transition-colors hover:bg-gray-200/70 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white"
                >{name}</a>
              ))}
            </>
          ))}
          <span class="mx-1.5 h-4 w-px bg-gray-300 dark:bg-white/15" aria-hidden="true"></span>
          <a
            href="/posts/"
            class="rounded-full px-2.5 py-1.5 text-gray-600 transition-colors hover:bg-gray-200/70 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-white/10 dark:hover:text-white"
          >전체 글</a>
        </nav>

        <div class="flex items-center gap-1">
          <button
            id="search-toggle"
            type="button"
            aria-label="검색"
            class="flex h-9 w-9 items-center justify-center rounded-full text-gray-600 transition-colors hover:bg-gray-200/70 dark:text-gray-400 dark:hover:bg-white/10"
          >
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
          </button>
          <button
            id="theme-toggle"
            type="button"
            aria-label="라이트/다크 모드 전환"
            class="flex h-9 w-9 items-center justify-center rounded-full text-gray-600 transition-colors hover:bg-gray-200/70 dark:text-gray-400 dark:hover:bg-white/10"
          >
            <svg class="hidden h-4.5 w-4.5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
            </svg>
            <svg class="h-4.5 w-4.5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
            </svg>
          </button>
          <!-- 모바일 햄버거 (lg 미만) -->
          <button
            id="menu-toggle"
            type="button"
            aria-label="메뉴 열기"
            aria-expanded="false"
            class="flex h-9 w-9 items-center justify-center rounded-full text-gray-600 transition-colors hover:bg-gray-200/70 dark:text-gray-400 dark:hover:bg-white/10 lg:hidden"
          >
            <svg id="menu-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg id="menu-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </div>

      <!-- 모바일 메뉴 패널: 대분류별 섹션 -->
      <div id="mobile-menu" class="hidden border-t border-gray-200/70 dark:border-white/10 lg:hidden">
        <nav class="mx-auto max-w-6xl space-y-4 px-4 py-4">
          <a href="/calc/" class="block rounded-xl border border-accent-500 px-3 py-2.5 text-center text-sm font-semibold text-accent-700 dark:text-accent-300">계산기</a>
          {CATEGORY_GROUPS.map((group) => (
            <div>
              <p class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-accent-600 dark:text-accent-400">
                <span class="inline-block h-3.5 w-1 rounded-full bg-accent-500"></span>
                {group.name}
              </p>
              <div class="grid grid-cols-2 gap-2">
                {Object.entries(group.categories).map(([slug, name]) => (
                  <a
                    href={`/category/${slug}/`}
                    class="rounded-xl border border-gray-200 px-3 py-2.5 text-center text-sm text-gray-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-white/10 dark:text-gray-300 dark:hover:border-accent-400 dark:hover:text-accent-400"
                  >{name}</a>
                ))}
              </div>
            </div>
          ))}
          <a
            href="/posts/"
            class="block rounded-xl bg-gray-900 px-3 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-gray-700 dark:bg-white/10 dark:hover:bg-white/20"
          >전체 글 보기</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl px-4 py-10">
      <slot />
    </main>

    <footer class="mt-16 border-t border-gray-200/70 dark:border-white/10">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-8 text-sm text-gray-500">
        <p>© {new Date().getFullYear()} {SITE_TITLE} — AI·테크 트렌드 노트</p>
        <nav class="flex flex-wrap gap-x-5 gap-y-2">
          <a href="/about/" class="transition-colors hover:text-gray-900 dark:hover:text-white">소개</a>
          <a href="/contact/" class="transition-colors hover:text-gray-900 dark:hover:text-white">문의</a>
          <a href="/privacy/" class="transition-colors hover:text-gray-900 dark:hover:text-white">개인정보처리방침</a>
          <a href="/terms/" class="transition-colors hover:text-gray-900 dark:hover:text-white">이용약관</a>
          <a href="/editorial-policy/" class="transition-colors hover:text-gray-900 dark:hover:text-white">편집 원칙</a>
          <a href="/affiliate-disclosure/" class="transition-colors hover:text-gray-900 dark:hover:text-white">광고·제휴 고지</a>
          <a href="/corrections/" class="transition-colors hover:text-gray-900 dark:hover:text-white">정정 안내</a>
        </nav>
      </div>
      <div class="mx-auto max-w-6xl px-4 pb-8 text-xs text-gray-400 dark:text-gray-500">
        <p>운영: 아우리온(Aurion) · 대표 이광희 · 문의: <a href="/contact/" class="underline-offset-2 hover:text-gray-600 hover:underline dark:hover:text-gray-200">문의 페이지</a></p>
      </div>
    </footer>

    <!-- 검색 모달 (Pagefind 정적 검색 — 빌드 후 인덱스 생성) -->
    <div id="search-modal" class="fixed inset-0 z-[60] hidden bg-black/50 p-4 backdrop-blur-sm sm:p-10">
      <div class="mx-auto max-w-xl rounded-2xl border border-gray-200 bg-white p-5 shadow-2xl dark:border-white/10 dark:bg-surface-900">
        <div class="mb-3 flex items-center justify-between">
          <p class="text-sm font-bold uppercase tracking-wide text-gray-400">검색</p>
          <button id="search-close" type="button" aria-label="닫기" class="rounded-full p-1.5 text-gray-500 hover:bg-gray-100 dark:hover:bg-white/10">✕</button>
        </div>
        <div id="pagefind-search"></div>
        <p id="search-fallback" class="hidden py-6 text-center text-sm text-gray-500">검색을 불러오지 못했어요. 잠시 후 다시 시도해 주세요.</p>
      </div>
    </div>

    <!-- 테마 토글 + 스크롤 리빌 — View Transitions 대응 재초기화 -->
    <script is:inline>
      const initPage = () => {
        const btn = document.getElementById('theme-toggle');
        if (btn && !btn.dataset.bound) {
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => {
            const dark = !document.documentElement.classList.contains('dark');
            document.documentElement.classList.toggle('dark', dark);
            document.cookie = `theme=${dark ? 'dark' : 'light'}; path=/; max-age=31536000; SameSite=Lax`;
          });
        }
        const menuBtn = document.getElementById('menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (menuBtn && menu && !menuBtn.dataset.bound) {
          menuBtn.dataset.bound = '1';
          menuBtn.addEventListener('click', () => {
            const open = menu.classList.toggle('hidden') === false;
            menuBtn.setAttribute('aria-expanded', String(open));
            document.getElementById('menu-icon-open').classList.toggle('hidden', open);
            document.getElementById('menu-icon-close').classList.toggle('hidden', !open);
          });
        }
        const observer = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              observer.unobserve(e.target);
            }
          }),
          { threshold: 0.08 }
        );
        document.querySelectorAll('.reveal:not(.revealed)').forEach((el) => observer.observe(el));

        // 읽기 진행바
        const bar = document.getElementById('read-progress');
        if (bar && !bar.dataset.bound) {
          bar.dataset.bound = '1';
          const update = () => {
            const max = document.documentElement.scrollHeight - window.innerHeight;
            const p = max > 0 ? window.scrollY / max : 0;
            bar.style.transform = `scaleX(${Math.min(1, Math.max(0, p))})`;
          };
          window.addEventListener('scroll', update, { passive: true });
          document.addEventListener('astro:page-load', update);
          update();
        }

        // 검색 모달 (Pagefind UI 지연 로드)
        const searchBtn = document.getElementById('search-toggle');
        const modal = document.getElementById('search-modal');
        if (searchBtn && modal && !searchBtn.dataset.bound) {
          searchBtn.dataset.bound = '1';
          let loaded = false;
          const open = async () => {
            modal.classList.remove('hidden');
            if (!loaded) {
              loaded = true;
              try {
                const css = document.createElement('link');
                css.rel = 'stylesheet';
                css.href = '/pagefind/pagefind-ui.css';
                document.head.appendChild(css);
                await new Promise((res, rej) => {
                  const s = document.createElement('script');
                  s.src = '/pagefind/pagefind-ui.js';
                  s.onload = res; s.onerror = rej;
                  document.head.appendChild(s);
                });
                new window.PagefindUI({ element: '#pagefind-search', showSubResults: false, showImages: false, translations: { placeholder: '검색어 입력…', zero_results: '"[SEARCH_TERM]" 결과 없음' } });
              } catch {
                document.getElementById('search-fallback').classList.remove('hidden');
              }
            }
            setTimeout(() => modal.querySelector('input')?.focus(), 80);
          };
          const close = () => modal.classList.add('hidden');
          searchBtn.addEventListener('click', open);
          document.getElementById('search-close').addEventListener('click', close);
          modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
          document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        }
      };
      initPage();
      document.addEventListener('astro:page-load', initPage);
    </script>
    <script is:inline>
      // 실시간 접속 하트비트(자체 카운터). 프로덕션에서만, /stats 제외. 개인정보 미전송.
      (function () {
        try {
          var h = location.hostname;
          if (h === 'localhost' || h === '127.0.0.1') return;
          if (location.pathname.indexOf('/stats') === 0) return;
          var K = 'pcn_vid';
          var id = sessionStorage.getItem(K);
          if (!id) { id = Math.random().toString(36).slice(2) + Date.now().toString(36); sessionStorage.setItem(K, id); }
          function beat() {
            try {
              fetch('/api/beat', {
                method: 'POST', keepalive: true,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id, title: document.title, path: location.pathname, lang: document.documentElement.lang })
              });
            } catch (e) {}
          }
          function hit() {
            try {
              var today = new Date().toISOString().slice(0, 10);
              var uid = localStorage.getItem('pcn_uid');
              var newVisitor = false;
              if (!uid) { uid = Math.random().toString(36).slice(2) + Date.now().toString(36); localStorage.setItem('pcn_uid', uid); newVisitor = true; }
              var newDay = (localStorage.getItem('pcn_day') !== today);
              if (newDay) localStorage.setItem('pcn_day', today);
              var path = location.pathname;
              var seen = sessionStorage.getItem('pcn_seen') || '|';
              var countView = seen.indexOf('|' + path + '|') < 0;   // 세션 내 첫 조회만(새로고침 무시)
              if (countView) sessionStorage.setItem('pcn_seen', seen + path + '|');
              if (!countView && !newVisitor && !newDay) return;      // 기록할 게 없으면 호출 안 함
              fetch('/api/hit', {
                method: 'POST', keepalive: true,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ path: path, title: document.title, countView: countView, newVisitor: newVisitor, newDay: newDay })
              });
            } catch (e) {}
          }
          hit();
          document.addEventListener('astro:after-swap', hit);
          beat();
          setInterval(beat, 30000);
          document.addEventListener('astro:after-swap', beat);
          document.addEventListener('visibilitychange', function () { if (!document.hidden) beat(); });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
