---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../consts';

export async function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const name = CATEGORIES[category];
const posts = (await getCollection('blog', ({ data, id }) => !data.draft && !id.includes('/') && data.category === category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={name} description={`${name} 카테고리의 글 목록입니다.`}>
  <h1 class="reveal mb-6 text-3xl font-extrabold tracking-tight">
    {name} <span class="text-lg font-normal text-gray-500">({posts.length})</span>
  </h1>
  {posts.length === 0 && <p class="py-8 text-gray-500">이 카테고리에는 아직 글이 없습니다.</p>}
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>
