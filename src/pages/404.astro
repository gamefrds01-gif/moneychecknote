---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// 최근 글 5개(한국어) — 홈 리다이렉트 대신 방문자가 바로 찾아가게
const recent = (await getCollection('blog', ({ data, id }) => !data.draft && !id.includes('/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---
<Layout title="페이지를 찾을 수 없습니다 (404)" description="요청하신 페이지를 찾을 수 없습니다." noindex={true} noAnalytics={true}>
  <div class="mx-auto max-w-xl py-16 text-center">
    <p class="text-6xl font-extrabold text-accent-500">404</p>
    <h1 class="mt-4 text-2xl font-bold">페이지를 찾을 수 없습니다</h1>
    <p class="mt-3 text-gray-500 dark:text-gray-400">주소가 바뀌었거나 삭제된 페이지일 수 있어요. 아래에서 검색하거나 최근 글을 확인해 보세요.</p>

    <form action="/search" method="get" class="mt-6 flex gap-2">
      <label for="q404" class="sr-only">검색</label>
      <input
        id="q404"
        type="search"
        name="q"
        placeholder="키워드로 검색 (예: MCP, 딥시크, 노션)"
        class="min-w-0 flex-1 rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm outline-none transition-colors focus:border-accent-500 dark:border-white/15 dark:bg-surface-800 dark:text-gray-100"
      />
      <button type="submit" class="rounded-xl bg-accent-500 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-accent-600">검색</button>
    </form>

    <div class="mt-4 flex justify-center gap-3">
      <a href="/" class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-bold text-gray-700 transition-colors hover:border-accent-500 dark:border-white/20 dark:text-gray-300">홈으로</a>
      <a href="/posts/" class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-bold text-gray-700 transition-colors hover:border-accent-500 dark:border-white/20 dark:text-gray-300">전체 글 보기</a>
    </div>

    {recent.length > 0 && (
      <div class="mt-10 text-left">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">최근 글</h2>
        <ul class="space-y-2">
          {recent.map((p) => (
            <li>
              <a href={`/posts/${p.id}/`} class="text-accent-600 transition-colors hover:underline dark:text-accent-400">{p.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</Layout>
