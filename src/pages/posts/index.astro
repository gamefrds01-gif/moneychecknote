---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data, id }) => !data.draft && !id.includes('/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="전체 글" description="Pointchecknote의 모든 글 목록입니다.">
  <h1 class="reveal mb-6 text-3xl font-extrabold tracking-tight">
    전체 글 <span class="text-lg font-normal text-gray-500">({posts.length})</span>
  </h1>
  {posts.length === 0 && <p class="py-8 text-gray-500">아직 발행된 글이 없습니다.</p>}
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>
