---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORY_GROUPS, SITE_TITLE } from '../consts';

const all = (await getCollection('blog', ({ data, id }) => !data.draft && !id.includes('/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byGroup = CATEGORY_GROUPS.map((group) => ({
  ...group,
  posts: all.filter((p) => p.data.category in group.categories).slice(0, 6),
}));

const featuredCalcs = [
  { href: '/calc/salary/', name: '연봉 실수령액', desc: '세후 월급 즉시 계산' },
  { href: '/calc/loan/', name: '대출 원리금', desc: '월 상환액·총이자' },
  { href: '/calc/severance/', name: '퇴직금', desc: '예상 퇴직금' },
  { href: '/calc/unemployment/', name: '실업급여', desc: '예상 수급액·일수' },
];
---

<Layout>
  <!-- 히어로 -->
  <section class="aurora reveal py-12 text-center sm:py-16">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-accent-600 dark:text-accent-400">
      Money Check Note
    </p>
    <h1 class="mx-auto max-w-2xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
      내 돈이 얼마인지,<br />
      <span class="bg-gradient-to-r from-accent-500 to-emerald-600 bg-clip-text text-transparent dark:from-accent-400 dark:to-emerald-500">바로 계산</span>합니다
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-gray-600 dark:text-gray-400">
      연봉 실수령액·퇴직금·대출이자 계산기와 정부지원금·환급·세금 정보. 공식 자료로 확인하고 확인일까지 적어 둡니다.
    </p>
    <div class="mt-7 flex flex-wrap justify-center gap-3">
      <a href="/calc/salary/" class="rounded-full bg-gray-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-gray-700 dark:bg-white dark:text-gray-900">연봉 실수령액 계산</a>
      <a href="/calc/" class="rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-white/15 dark:text-gray-300">계산기 전체</a>
    </div>
  </section>

  <!-- 계산기 바로가기 -->
  <section class="reveal mb-12">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {featuredCalcs.map((c) => (
        <a href={c.href} class="rounded-2xl border border-gray-200 bg-white p-4 transition-colors hover:border-accent-500 dark:border-white/10 dark:bg-surface-900">
          <p class="text-base font-bold">{c.name} 계산기</p>
          <p class="mt-1 text-xs text-gray-500">{c.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 이 사이트가 하는 일 -->
  <section class="reveal mb-12 grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900">
      <p class="text-xs font-bold uppercase tracking-wide text-accent-600 dark:text-accent-400">계산</p>
      <h2 class="mt-1 text-base font-bold">숫자로 바로 답</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">연봉·퇴직금·대출·실업급여를 최신 요율로 계산합니다. 계산 근거와 확인일을 함께 공개해요.</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900">
      <p class="text-xs font-bold uppercase tracking-wide text-accent-600 dark:text-accent-400">혜택</p>
      <h2 class="mt-1 text-base font-bold">받을 수 있는 돈</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">정부지원금·환급·숨은 돈을 공식 출처로 확인해 신청 방법까지 정리합니다.</p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900">
      <p class="text-xs font-bold uppercase tracking-wide text-accent-600 dark:text-accent-400">신뢰</p>
      <h2 class="mt-1 text-base font-bold">출처와 확인일</h2>
      <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">추측 대신 공식 자료. 요율·정책이 바뀌면 확인일을 갱신합니다. 운영은 <a href="/authors/editorial/" class="underline">여기</a>.</p>
    </div>
  </section>

  <!-- 카테고리별 최신 글 -->
  {byGroup.filter((group) => group.posts.length > 0).map((group) => (
    <section class="pb-12">
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="flex items-center gap-2.5 text-xl font-bold tracking-tight">
          <span class="inline-block h-5 w-1 rounded-full bg-accent-500"></span>
          {group.name}
        </h2>
        <div class="flex flex-wrap gap-1.5 text-xs">
          {Object.entries(group.categories).map(([slug, name]) => (
            <a href={`/category/${slug}/`} class="rounded-full border border-gray-200 px-2.5 py-1 text-gray-600 transition-colors hover:border-accent-500 hover:text-accent-600 dark:border-white/10 dark:text-gray-400">{name}</a>
          ))}
        </div>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {group.posts.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  ))}
</Layout>
