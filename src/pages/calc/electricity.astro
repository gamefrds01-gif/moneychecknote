---
// 전기요금 계산기 — 주택용 저압 누진 3구간(한전). 기본요금+전력량요금+기후환경+연료비+부가세+기금.
import Layout from '../../layouts/Layout.astro';
import { ELEC, SOURCE_META } from '../../data/rates';
import { breadcrumbSchema } from '../../lib/schema';
import SourceMeta from '../../components/SourceMeta.astro';

const client = { ELEC };

const faqs = [
  { q: '전기요금 누진제가 뭔가요?', a: '주택용 전기요금은 많이 쓸수록 단가가 오르는 3구간 누진제입니다. 200kWh 이하(1구간)는 kWh당 낮은 단가, 200~400kWh(2구간)는 중간, 400kWh 초과(3구간)는 높은 단가가 적용됩니다. 기본요금도 사용 구간이 올라갈수록 커집니다.' },
  { q: '청구서 금액은 어떻게 구성되나요?', a: '기본요금 + 전력량요금(누진) + 기후환경요금 + 연료비조정요금을 더한 "전기요금계"에 부가가치세 10%와 전력산업기반기금 3.7%가 붙습니다. TV 수신료(2,500원)가 함께 청구되기도 합니다.' },
  { q: '여름에 요금이 더 나오는 이유는?', a: '냉방으로 사용량이 늘어 누진 상위 구간에 걸리기 때문입니다. 하계(7~8월)에는 누진 구간 폭을 완화해 주지만, 사용량 자체가 크면 3구간·슈퍼유저 단가가 적용돼 요금이 급증합니다.' },
  { q: '계산 결과가 실제 청구서와 다를 수 있나요?', a: '네. 기후환경요금·연료비조정요금 단가와 계절별 구간은 한전 요율 개정에 따라 바뀌고, 복지할인·필수사용량 보장공제 등도 반영되지 않은 추정입니다. 정확한 금액은 한전ON 앱이나 고객센터(123)로 확인하세요.' },
];

const jsonLd = [
  breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }, { name: '전기요금 계산기', url: '/calc/electricity/' }]),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: '전기요금 계산기 2026', applicationCategory: 'FinanceApplication', operatingSystem: 'All', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' }, url: 'https://money.pointchecknote.com/calc/electricity/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout title="전기요금 계산기 2026 — 주택용 누진 3구간 요금 계산" description="월 사용량(kWh)을 넣으면 주택용 저압 전기요금을 누진 3구간으로 계산합니다. 기본요금·전력량요금·기후환경·연료비·부가세·기금까지 반영." jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl">
    <nav class="mb-4 text-sm text-gray-500" aria-label="위치"><a href="/" class="hover:text-accent-600">홈</a> › <a href="/calc/" class="hover:text-accent-600">계산기</a> › <span class="text-gray-700 dark:text-gray-300">전기요금</span></nav>
    <header class="reveal mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">전기요금 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">한 달 사용량(kWh)을 넣으면 <strong>주택용 저압 누진 3구간</strong> 기준 예상 청구액을 계산합니다. 부가세·기금까지 반영해요.</p>
    </header>

    <section class="reveal mb-5 overflow-hidden rounded-3xl border border-accent-200 bg-gradient-to-br from-accent-50 to-white p-6 shadow-sm dark:border-accent-500/30 dark:from-accent-500/10 dark:to-surface-900">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-300">예상 청구금액</p>
      <p class="mt-1"><span id="total" class="tnum text-4xl font-extrabold sm:text-5xl">0</span> <span class="text-xl font-bold text-gray-500">원</span></p>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">적용 구간: <span id="tier" class="font-semibold">-</span></p>
    </section>

    <section class="reveal rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900 sm:p-6">
      <label for="kwh" class="mb-1 block text-sm font-semibold">월 사용량 (kWh)</label>
      <div class="mb-2 flex flex-wrap gap-2">
        {[150,250,350,450,600].map((v) => (<button type="button" class="kpreset rounded-full border border-gray-300 px-3 py-1 text-sm font-semibold hover:border-accent-500 hover:text-accent-600 dark:border-white/15" data-v={v}>{v}</button>))}
      </div>
      <input id="kwh" type="text" inputmode="numeric" autocomplete="off" value="300" class="mb-2 w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-lg tnum dark:border-white/15 dark:bg-surface-800" />
      <input id="kwh-range" type="range" class="rng" min="0" max="1000" step="10" value="300" aria-label="사용량 슬라이더" />
      <label class="mt-3 flex cursor-pointer items-center gap-2 text-sm"><input id="tv" type="checkbox" class="h-4 w-4" checked /> <span>TV 수신료 2,500원 포함</span></label>
    </section>

    <section class="reveal mt-5 rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900">
      <p class="mb-3 text-sm font-bold">요금 상세</p>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between"><dt class="text-gray-600 dark:text-gray-400">기본요금</dt><dd class="tnum font-semibold" id="d-base">0</dd></div>
        <div class="flex justify-between"><dt class="text-gray-600 dark:text-gray-400">전력량요금 (누진)</dt><dd class="tnum font-semibold" id="d-energy">0</dd></div>
        <div class="flex justify-between"><dt class="text-gray-600 dark:text-gray-400">기후환경요금</dt><dd class="tnum font-semibold" id="d-climate">0</dd></div>
        <div class="flex justify-between"><dt class="text-gray-600 dark:text-gray-400">연료비조정요금</dt><dd class="tnum font-semibold" id="d-fuel">0</dd></div>
        <div class="flex justify-between border-t border-gray-200 pt-2 dark:border-white/10"><dt class="font-semibold">전기요금계</dt><dd class="tnum font-bold" id="d-sub">0</dd></div>
        <div class="flex justify-between"><dt class="text-gray-600 dark:text-gray-400">부가가치세 (10%)</dt><dd class="tnum font-semibold" id="d-vat">0</dd></div>
        <div class="flex justify-between"><dt class="text-gray-600 dark:text-gray-400">전력산업기반기금 (3.7%)</dt><dd class="tnum font-semibold" id="d-fund">0</dd></div>
        <div class="flex justify-between" id="row-tv"><dt class="text-gray-600 dark:text-gray-400">TV 수신료</dt><dd class="tnum font-semibold" id="d-tv">0</dd></div>
      </dl>
    </section>

    <SourceMeta meta={SOURCE_META.elec} asof={ELEC.asof} />

    <section class="reveal mt-8">
      <h2 class="mb-3 text-xl font-bold tracking-tight">자주 묻는 질문</h2>
      <div class="space-y-3">{faqs.map((f) => (<details class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-900"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{f.a}</p></details>))}</div>
    </section>
  </div>

  <script is:inline define:vars={{ client }}>
    (function () {
      var E = client.ELEC;
      var $ = function (id) { return document.getElementById(id); };
      var digits = function (v) { return parseInt(String(v).replace(/[^0-9]/g, ''), 10) || 0; };
      var won = function (n) { return Math.round(n).toLocaleString('ko-KR'); };
      function calc() {
        var kwh = digits($('kwh').value);
        var tierIdx = kwh <= E.tier1Max ? 0 : kwh <= E.tier2Max ? 1 : 2;
        var base = E.baseFee[tierIdx];
        // 누진 전력량요금
        var t1 = Math.min(kwh, E.tier1Max);
        var t2 = Math.max(0, Math.min(kwh, E.tier2Max) - E.tier1Max);
        var t3 = Math.max(0, kwh - E.tier2Max);
        var energy = t1 * E.energyRate[0] + t2 * E.energyRate[1] + t3 * E.energyRate[2];
        var climate = kwh * E.climateRate;
        var fuel = kwh * E.fuelAdjRate;
        var sub = base + energy + climate + fuel;
        var vat = sub * E.vatRate;
        var fund = sub * E.fundRate;
        var tv = $('tv').checked ? E.tvFee : 0;
        var total = Math.round(sub) + Math.round(vat) + Math.round(fund) + tv;

        $('d-base').textContent = won(base);
        $('d-energy').textContent = won(energy);
        $('d-climate').textContent = won(climate);
        $('d-fuel').textContent = won(fuel);
        $('d-sub').textContent = won(sub);
        $('d-vat').textContent = won(vat);
        $('d-fund').textContent = won(fund);
        $('d-tv').textContent = won(tv);
        $('row-tv').style.display = $('tv').checked ? '' : 'none';
        $('total').textContent = won(total);
        $('tier').textContent = (tierIdx + 1) + '구간 (' + (tierIdx === 0 ? '200kWh 이하' : tierIdx === 1 ? '201~400kWh' : '400kWh 초과') + ')';
      }
      var kwh = $('kwh'), range = $('kwh-range');
      kwh.addEventListener('input', function () { var d = digits(kwh.value); kwh.value = d ? d.toLocaleString('ko-KR') : ''; range.value = Math.min(1000, d); calc(); });
      range.addEventListener('input', function () { kwh.value = Number(range.value).toLocaleString('ko-KR'); calc(); });
      $('tv').addEventListener('change', calc);
      Array.prototype.forEach.call(document.querySelectorAll('.kpreset'), function (b) { b.addEventListener('click', function () { var v = digits(b.getAttribute('data-v')); kwh.value = v.toLocaleString('ko-KR'); range.value = v; calc(); }); });
      calc();
    })();
  </script>
</Layout>
