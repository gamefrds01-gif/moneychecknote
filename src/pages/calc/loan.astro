---
// 대출 원리금 계산기 — 원리금균등/원금균등, 월 상환액·총이자.
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../lib/schema';

const faqs = [
  { q: '원리금균등과 원금균등, 뭐가 다른가요?', a: '원리금균등은 매달 갚는 금액(원금+이자)이 같아 관리가 쉽습니다. 원금균등은 매달 원금을 똑같이 나눠 갚고 이자는 남은 원금에 붙어, 초반 상환액이 크고 갈수록 줄며 총이자는 더 적습니다.' },
  { q: '중도상환수수료는 반영되나요?', a: '아니요. 이 계산기는 약정 이자만 계산합니다. 중도상환수수료·인지세·근저당 설정비 등 부대비용은 상품마다 달라 포함하지 않았습니다.' },
  { q: '거치기간이 있으면요?', a: '거치기간(이자만 내는 기간)은 이 계산기에 없습니다. 거치 후 상환 상품은 은행 상환스케줄로 확인하세요. 여기서는 첫 달부터 원리금을 갚는 기준입니다.' },
];

const jsonLd = [
  breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }, { name: '대출 원리금 계산기', url: '/calc/loan/' }]),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: '대출 원리금 계산기', applicationCategory: 'FinanceApplication', operatingSystem: 'All', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' }, url: 'https://money.pointchecknote.com/calc/loan/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout title="대출 원리금 계산기 — 원리금균등·원금균등 월 상환액" description="대출금·이자율·기간을 넣으면 원리금균등·원금균등 방식의 월 상환액과 총이자를 바로 계산합니다. 두 방식을 나란히 비교하세요." jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl">
    <nav class="mb-4 text-sm text-gray-500" aria-label="위치"><a href="/" class="hover:text-accent-600">홈</a> › <a href="/calc/" class="hover:text-accent-600">계산기</a> › <span class="text-gray-700 dark:text-gray-300">대출 원리금</span></nav>
    <header class="reveal mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">대출 원리금 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">대출금·연이자율·기간을 넣으면 <strong>월 상환액과 총이자</strong>를 계산합니다. 원리금균등·원금균등 두 방식을 함께 보여줘요.</p>
    </header>

    <section class="reveal mb-5 grid gap-4 sm:grid-cols-2">
      <div class="overflow-hidden rounded-3xl border border-accent-200 bg-gradient-to-br from-accent-50 to-white p-6 shadow-sm dark:border-accent-500/30 dark:from-accent-500/10 dark:to-surface-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-300">원리금균등 · 월 상환액</p>
        <p class="mt-1"><span id="eq-monthly" class="tnum text-3xl font-extrabold sm:text-4xl">0</span> <span class="font-bold text-gray-500">원</span></p>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">총이자 <span id="eq-interest" class="tnum font-semibold">0</span> 원 · 총상환 <span id="eq-total" class="tnum font-semibold">0</span> 원</p>
      </div>
      <div class="rounded-3xl border border-gray-200 bg-white p-6 dark:border-white/10 dark:bg-surface-900">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">원금균등 · 첫달~막달</p>
        <p class="mt-1"><span id="pr-first" class="tnum text-2xl font-extrabold">0</span> <span class="text-sm text-gray-500">→</span> <span id="pr-last" class="tnum text-2xl font-extrabold">0</span> <span class="text-sm font-bold text-gray-500">원</span></p>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">총이자 <span id="pr-interest" class="tnum font-semibold">0</span> 원</p>
      </div>
    </section>

    <section class="reveal rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900 sm:p-6">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="sm:col-span-3">
          <label for="amount" class="mb-1 block text-sm font-semibold">대출금 (원)</label>
          <input id="amount" type="text" inputmode="numeric" autocomplete="off" value="100,000,000" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-lg tnum dark:border-white/15 dark:bg-surface-800" />
        </div>
        <div>
          <label for="rate" class="mb-1 block text-sm font-semibold">연이자율 (%)</label>
          <input id="rate" type="text" inputmode="decimal" autocomplete="off" value="4.5" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 tnum dark:border-white/15 dark:bg-surface-800" />
        </div>
        <div>
          <label for="years" class="mb-1 block text-sm font-semibold">기간 (년)</label>
          <input id="years" type="text" inputmode="numeric" autocomplete="off" value="30" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 tnum dark:border-white/15 dark:bg-surface-800" />
        </div>
        <div>
          <label for="months" class="mb-1 block text-sm font-semibold">+ 개월</label>
          <input id="months" type="text" inputmode="numeric" autocomplete="off" value="0" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 tnum dark:border-white/15 dark:bg-surface-800" />
        </div>
      </div>
    </section>

    <section class="reveal mt-8">
      <h2 class="mb-3 text-xl font-bold tracking-tight">자주 묻는 질문</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-900"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{f.a}</p></details>
        ))}
      </div>
      <p class="mt-4 text-xs text-gray-500">약정 이자만 계산합니다. 중도상환수수료·부대비용 제외. 실제 상환액은 은행 상환스케줄로 확인하세요.</p>
    </section>
  </div>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var digits = function (v) { return parseInt(String(v).replace(/[^0-9]/g, ''), 10) || 0; };
      var fnum = function (v) { return parseFloat(String(v).replace(/[^0-9.]/g, '')) || 0; };
      var won = function (n) { return Math.round(n).toLocaleString('ko-KR'); };
      function fmtField(el) { var d = digits(el.value); el.value = d ? d.toLocaleString('ko-KR') : ''; }
      function calc() {
        var P = digits($('amount').value);
        var annual = fnum($('rate').value);
        var n = (digits($('years').value) * 12) + digits($('months').value);
        if (n <= 0) n = 1;
        var r = annual / 100 / 12;
        // 원리금균등
        var eqM = r === 0 ? P / n : P * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
        var eqTotal = eqM * n, eqInt = eqTotal - P;
        // 원금균등
        var principal = P / n;
        var prFirst = principal + P * r;
        var prLast = principal + principal * r;
        var prInt = 0; for (var i = 0; i < n; i++) { prInt += (P - principal * i) * r; }
        $('eq-monthly').textContent = won(eqM);
        $('eq-interest').textContent = won(eqInt);
        $('eq-total').textContent = won(eqTotal);
        $('pr-first').textContent = won(prFirst);
        $('pr-last').textContent = won(prLast);
        $('pr-interest').textContent = won(prInt);
      }
      $('amount').addEventListener('input', function () { fmtField($('amount')); calc(); });
      ['rate', 'years', 'months'].forEach(function (id) { $(id).addEventListener('input', calc); });
      calc();
    })();
  </script>
</Layout>
