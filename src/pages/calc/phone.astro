---
// 휴대폰 요금 계산기 — 단말기 선택(출고가 자동)+통신사·요금제 선택+공시지원 vs 선택약정 자동계산. 3단 명세서.
import Layout from '../../layouts/Layout.astro';
import { PHONE, SOURCE_META } from '../../data/rates';
import { breadcrumbSchema } from '../../lib/schema';
import SourceMeta from '../../components/SourceMeta.astro';

const client = { PHONE };

const faqs = [
  { q: '선택약정 25%와 공시지원금, 뭐가 유리한가요?', a: '선택약정은 단말기 할인 대신 매달 통신요금의 25%를 깎아주고, 공시지원금은 요금 할인 대신 단말기 값을 깎아줍니다. 이 계산기는 같은 조건으로 두 방식의 할부기간 총액을 계산해 유리한 쪽을 표시합니다. 보통 고가 요금제를 오래 쓰면 선택약정이, 공시지원금이 큰 기종이거나 번호이동 전환지원금까지 받으면 공시지원금이 유리합니다.' },
  { q: '단통법이 폐지됐다는데 뭐가 달라졌나요?', a: '2025년 7월 22일 단말기유통법이 폐지되어 예전의 추가지원금 상한(공시지원금의 15%)이 사라졌습니다. 판매처마다 추가지원금을 자유롭게 줄 수 있어 같은 폰도 매장별 가격차가 큽니다. "추가지원금" 칸에 실제 매장에서 제시한 금액을 넣으세요.' },
  { q: '고가 요금제 유지 조건이 있다던데요?', a: '공시지원금이나 추가지원금을 많이 받으면 통상 일정 기간(예: 6개월) 고가 요금제를 유지하는 조건이 붙는 경우가 많습니다. 중간에 저가 요금제로 바꾸면 지원금 차액을 반환할 수 있으니, 계약서의 요금제 유지 의무 기간을 꼭 확인하세요.' },
  { q: '할부수수료(이자)는 왜 붙나요?', a: '단말기 값을 할부로 나눠 내면 통신사가 연 5.9% 수준의 할부수수료를 부과합니다. 할부기간을 0(완납)으로 하면 이자가 없고, 24·30·36개월로 늘릴수록 매달 부담은 줄지만 총이자는 늘어납니다.' },
  { q: '요금제·출고가가 실제와 다른데요?', a: '통신 3사는 요금제를 수시로 개편합니다(2026년 6~7월 3사 통합요금제 개편). 요금제·출고가는 확인일 기준이며, 값을 직접 수정하면 정확히 계산됩니다. 공식 지원금은 스마트초이스(smartchoice.or.kr)에서 확인하세요.' },
];

const jsonLd = [
  breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }, { name: '휴대폰 요금 계산기', url: '/calc/phone/' }]),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: '휴대폰 요금 계산기', applicationCategory: 'FinanceApplication', operatingSystem: 'All', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' }, url: 'https://money.pointchecknote.com/calc/phone/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout title="휴대폰 요금 계산기 — 단말기·요금제 선택 월 청구요금 명세서" description="단말기와 요금제를 고르면 출고가·할부금(5.9%)·통신요금이 자동 계산됩니다. 공시지원금 vs 선택약정 25%를 비교해 월 청구요금(부가세 포함)을 명세서로 보여줍니다." jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl">
    <nav class="mb-4 text-sm text-gray-500" aria-label="위치"><a href="/" class="hover:text-accent-600">홈</a> › <a href="/calc/" class="hover:text-accent-600">계산기</a> › <span class="text-gray-700 dark:text-gray-300">휴대폰 요금</span></nav>
    <header class="reveal mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">휴대폰 요금 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">단말기와 요금제를 고르면 <strong>출고가·할부금·통신요금</strong>이 자동 계산됩니다. <strong>공시지원금 vs 선택약정</strong> 중 유리한 쪽까지 명세서로 보여줘요.</p>
    </header>

    <!-- 상단: 선택 -->
    <section class="reveal mb-5 rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900 sm:p-6">
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-sm font-semibold">통신사</label>
          <div id="carriers" class="grid grid-cols-3 gap-2">
            <button type="button" data-c="SKT" class="carrier rounded-xl border px-2 py-2 text-sm font-semibold">SKT</button>
            <button type="button" data-c="KT" class="carrier rounded-xl border px-2 py-2 text-sm font-semibold">KT</button>
            <button type="button" data-c="LGU+" class="carrier rounded-xl border px-2 py-2 text-sm font-semibold">LG U+</button>
          </div>
        </div>
        <div>
          <label class="mb-1 block text-sm font-semibold">가입 구분</label>
          <div id="joins" class="grid grid-cols-2 gap-2">
            <button type="button" data-j="mnp" class="join rounded-xl border px-2 py-2 text-sm font-semibold">번호이동</button>
            <button type="button" data-j="new" class="join rounded-xl border px-2 py-2 text-sm font-semibold">신규·기변</button>
          </div>
        </div>
        <div>
          <label for="device" class="mb-1 block text-sm font-semibold">단말기</label>
          <select id="device" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm dark:border-white/15 dark:bg-surface-800"></select>
        </div>
        <div>
          <label for="planSel" class="mb-1 block text-sm font-semibold">요금제 <span class="text-xs text-gray-400">(월정액)</span></label>
          <select id="planSel" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-sm dark:border-white/15 dark:bg-surface-800"></select>
        </div>
      </div>

      <div class="mt-4">
        <label class="mb-1 block text-sm font-semibold">할인 방식</label>
        <div id="methods" class="grid grid-cols-2 gap-2">
          <button type="button" data-m="pub" class="mbtn rounded-xl border px-2 py-2.5 text-sm font-semibold">공시지원금 (단말기↓)</button>
          <button type="button" data-m="sel" class="mbtn rounded-xl border px-2 py-2.5 text-sm font-semibold">선택약정 (요금 25%↓)</button>
        </div>
      </div>

      <div class="mt-4">
        <label class="mb-1 block text-sm font-semibold">할부 기간</label>
        <div id="terms" class="flex flex-wrap gap-2"></div>
      </div>
    </section>

    <!-- 3단 명세서 -->
    <section class="reveal grid gap-4 lg:grid-cols-3">
      <!-- ① 월 할부금 -->
      <div class="overflow-hidden rounded-3xl border border-gray-200 bg-white dark:border-white/10 dark:bg-surface-900">
        <div class="border-b border-gray-200 bg-blue-50 px-4 py-2.5 text-center text-sm font-bold text-blue-800 dark:border-white/10 dark:bg-blue-500/15 dark:text-blue-300">월 할부금 (제품가격) ①</div>
        <div class="space-y-2 p-4 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">제품명</span><span id="o-name" class="font-semibold">-</span></div>
          <div class="flex justify-between"><span class="text-gray-500">출고가</span><span><input id="price" type="text" inputmode="numeric" class="w-28 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="border-t border-dashed border-gray-200 dark:border-white/10"></div>
          <div class="flex items-center justify-between" data-pub><span class="text-gray-500">공시지원금</span><span><input id="subsidy" type="text" inputmode="numeric" class="w-28 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="flex items-center justify-between" data-pub data-mnp><span class="text-gray-500">전환지원금</span><span><input id="switchSub" type="text" inputmode="numeric" class="w-28 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="flex items-center justify-between" data-pub><span class="text-gray-500">추가지원금</span><span><input id="extraSub" type="text" inputmode="numeric" class="w-28 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="flex items-center justify-between"><span class="text-gray-500">할부 선납</span><span><input id="prepay" type="text" inputmode="numeric" class="w-28 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="flex justify-between border-t border-dashed border-gray-200 pt-2 dark:border-white/10"><span class="font-semibold">할부 원금</span><span id="o-principal" class="tnum font-bold">0</span></div>
          <div class="flex justify-between"><span class="text-gray-500">할부 이자 <span class="text-xs text-gray-400">(연 5.9%)</span></span><span id="o-interest" class="tnum">0</span></div>
          <div class="mt-1 flex items-baseline justify-between border-t-2 border-gray-900 pt-2 dark:border-white/40"><span class="font-bold">월 할부금 ①</span><span><span id="o-device" class="tnum text-lg font-extrabold text-rose-600 dark:text-rose-400">0</span><span class="text-xs text-gray-500"> 원</span></span></div>
        </div>
      </div>

      <!-- ② 통신 요금 -->
      <div class="overflow-hidden rounded-3xl border border-gray-200 bg-white dark:border-white/10 dark:bg-surface-900">
        <div class="border-b border-gray-200 bg-rose-50 px-4 py-2.5 text-center text-sm font-bold text-rose-800 dark:border-white/10 dark:bg-rose-500/15 dark:text-rose-300">통신 요금 ②</div>
        <div class="space-y-2 p-4 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">요금제</span><span id="o-plan" class="font-semibold">-</span></div>
          <div class="flex items-center justify-between"><span class="text-gray-500">기본요금</span><span><input id="fee" type="text" inputmode="numeric" class="w-28 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="border-t border-dashed border-gray-200 dark:border-white/10"></div>
          <div class="flex justify-between" data-sel><span class="text-gray-500">선택약정 할인 <span class="text-xs text-gray-400">25%</span></span><span id="o-seldisc" class="tnum text-accent-600 dark:text-accent-400">0</span></div>
          <div class="flex items-center justify-between"><span class="text-gray-500">기타 할인 <span class="text-xs text-gray-400">복지·제휴·결합</span></span><span><input id="etcDisc" type="text" inputmode="numeric" class="w-24 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="flex items-center justify-between"><span class="text-gray-500">부가서비스</span><span><input id="addon" type="text" inputmode="numeric" class="w-24 rounded border border-gray-300 bg-white px-2 py-1 text-right tnum dark:border-white/15 dark:bg-surface-800" value="0" /></span></div>
          <div class="mt-1 flex items-baseline justify-between border-t-2 border-gray-900 pt-2 dark:border-white/40"><span class="font-bold">월 통신요금 ②</span><span><span id="o-comm" class="tnum text-lg font-extrabold text-rose-600 dark:text-rose-400">0</span><span class="text-xs text-gray-500"> 원</span></span></div>
        </div>
      </div>

      <!-- ③ 월 청구요금 -->
      <div class="overflow-hidden rounded-3xl border border-accent-200 bg-white dark:border-accent-500/30 dark:bg-surface-900">
        <div class="border-b border-accent-200 bg-amber-50 px-4 py-2.5 text-center text-sm font-bold text-amber-800 dark:border-white/10 dark:bg-amber-500/15 dark:text-amber-300">월 청구요금 ①+②</div>
        <div class="p-4 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">월 할부금 ①</span><span id="s-device" class="tnum font-semibold">0</span></div>
          <div class="mt-1 flex justify-between"><span class="text-gray-500">월 통신요금 ②</span><span id="s-comm" class="tnum font-semibold">0</span></div>
          <div class="mt-3 rounded-2xl bg-accent-50 p-3 text-center dark:bg-accent-500/10">
            <p class="text-xs font-semibold text-accent-700 dark:text-accent-300">월 청구액 ①+②</p>
            <p class="mt-0.5"><span id="s-total" class="tnum text-3xl font-extrabold text-rose-600 dark:text-rose-400">0</span> <span class="font-bold text-gray-500">원</span></p>
            <p class="mt-0.5 text-[11px] text-gray-500"><span id="s-months">24</span>개월 간 납부, VAT 및 할부이자 포함</p>
          </div>
          <!-- 약정 비교 -->
          <div class="mt-3 rounded-2xl border border-gray-200 p-3 dark:border-white/10">
            <p class="mb-2 text-center text-xs font-semibold">약정별 월 청구요금 비교 (원)</p>
            <div class="space-y-1.5">
              <div class="flex items-center gap-2 text-xs"><span class="w-14 shrink-0 text-gray-500">공시지원</span><div class="h-4 flex-1 overflow-hidden rounded bg-gray-100 dark:bg-white/10"><div id="bar-pub" class="bar-fill h-full rounded bg-blue-500" style="width:0%"></div></div><span id="cmp-pub" class="tnum w-16 shrink-0 text-right font-semibold">0</span></div>
              <div class="flex items-center gap-2 text-xs"><span class="w-14 shrink-0 text-gray-500">선택약정</span><div class="h-4 flex-1 overflow-hidden rounded bg-gray-100 dark:bg-white/10"><div id="bar-sel" class="bar-fill h-full rounded bg-amber-400" style="width:0%"></div></div><span id="cmp-sel" class="tnum w-16 shrink-0 text-right font-semibold">0</span></div>
            </div>
            <p id="verdict" class="mt-2 text-center text-xs font-semibold text-accent-700 dark:text-accent-300">-</p>
          </div>
        </div>
      </div>
    </section>

    <p class="reveal mt-4 text-xs text-gray-500">{PHONE.note}</p>

    <SourceMeta meta={SOURCE_META.phone} asof={PHONE.asof} />

    <section class="reveal mt-8">
      <h2 class="mb-3 text-xl font-bold tracking-tight">자주 묻는 질문</h2>
      <div class="space-y-3">{faqs.map((f) => (<details class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-900"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{f.a}</p></details>))}</div>
    </section>
  </div>

  <script is:inline define:vars={{ client }}>
    (function () {
      var P = client.PHONE;
      var $ = function (id) { return document.getElementById(id); };
      var digits = function (v) { return parseInt(String(v).replace(/[^0-9]/g, ''), 10) || 0; };
      var won = function (n) { return Math.round(n).toLocaleString('ko-KR'); };
      function fmtField(el) { var d = digits(el.value); el.value = d ? d.toLocaleString('ko-KR') : '0'; }

      var carrier = 'SKT', method = 'pub', join = 'mnp', term = 24, planOnline = false;

      // 단말기 할부(원리금균등). n=0 → 완납(월 0, 이자 0)
      function device(principal, n) {
        if (principal <= 0) return { monthly: 0, total: 0, interest: 0 };
        if (n <= 0) return { monthly: 0, total: principal, interest: 0 };
        var r = P.installmentAPR / 12;
        var m = principal * r / (1 - Math.pow(1 + r, -n));
        return { monthly: m, total: m * n, interest: m * n - principal };
      }
      function fillDevices() {
        var s = $('device'); s.innerHTML = '';
        P.devices.forEach(function (d, i) { var o = document.createElement('option'); o.value = i; o.textContent = d.name + (d.price ? ' · ' + d.price.toLocaleString('ko-KR') + '원' : ''); s.appendChild(o); });
      }
      function fillPlans() {
        var s = $('planSel'); s.innerHTML = '';
        (P.plans[carrier] || []).forEach(function (pl, i) { var o = document.createElement('option'); o.value = i; o.textContent = pl.name + ' · ' + pl.fee.toLocaleString('ko-KR') + '원'; s.appendChild(o); });
        applyPlan();
      }
      function applyDevice() { var d = P.devices[parseInt($('device').value) || 0]; if (d && d.price) $('price').value = d.price.toLocaleString('ko-KR'); $('o-name').textContent = d ? d.name.replace(' · 0원','') : '-'; }
      function applyPlan() { var pl = (P.plans[carrier] || [])[parseInt($('planSel').value) || 0]; if (pl) { $('fee').value = pl.fee.toLocaleString('ko-KR'); planOnline = !!pl.online; $('o-plan').textContent = pl.name; } }
      function fillTerms() {
        var box = $('terms'); box.innerHTML = '';
        P.months.forEach(function (m) {
          var b = document.createElement('button'); b.type = 'button';
          b.className = 'term rounded-lg border px-3 py-1.5 text-sm font-semibold ' + (m === term ? 'border-accent-500 bg-accent-50 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300' : 'border-gray-300 dark:border-white/15');
          b.textContent = m === 0 ? '완납' : m;
          b.addEventListener('click', function () { term = m; fillTerms(); calc(); });
          box.appendChild(b);
        });
      }

      // 한 방식의 원가 계산
      function costOf(m, inp) {
        var principal = m === 'pub' ? Math.max(0, inp.price - inp.subsidy - inp.extra - inp.sw - inp.prepay) : Math.max(0, inp.price - inp.prepay);
        var dev = device(principal, inp.n);
        var seldisc = (m === 'sel' && !planOnline) ? inp.fee * P.selectiveDiscount : 0;
        var comm = inp.fee - seldisc - inp.etc + inp.addon;
        var nn = inp.n > 0 ? inp.n : 24;
        return { principal: principal, deviceMonthly: dev.monthly, interest: dev.interest, seldisc: seldisc, comm: comm, monthly: dev.monthly + comm, total: dev.total + comm * nn };
      }
      function readInputs() {
        return {
          price: digits($('price').value), subsidy: digits($('subsidy').value), extra: digits($('extraSub').value),
          sw: join === 'mnp' ? Math.min(digits($('switchSub').value), P.switchSubsidyMax) : 0,
          prepay: digits($('prepay').value), fee: digits($('fee').value), etc: digits($('etcDisc').value), addon: digits($('addon').value), n: term,
        };
      }
      function calc() {
        var inp = readInputs();
        var pub = costOf('pub', inp), sel = costOf('sel', inp);
        var cur = method === 'pub' ? pub : sel;

        // ①
        $('o-principal').textContent = won(cur.principal);
        $('o-interest').textContent = won(cur.interest);
        $('o-device').textContent = won(cur.deviceMonthly);
        // ②
        $('o-seldisc').textContent = '-' + won(cur.seldisc);
        $('o-comm').textContent = won(cur.comm);
        // ③
        $('s-device').textContent = won(cur.deviceMonthly);
        $('s-comm').textContent = won(cur.comm);
        $('s-total').textContent = won(cur.monthly);
        $('s-months').textContent = inp.n > 0 ? inp.n : 24;

        // 비교
        $('cmp-pub').textContent = won(pub.monthly);
        $('cmp-sel').textContent = won(sel.monthly);
        var mx = Math.max(pub.monthly, sel.monthly, 1);
        $('bar-pub').style.width = (pub.monthly / mx * 100) + '%';
        $('bar-sel').style.width = (sel.monthly / mx * 100) + '%';
        var diffT = Math.abs(pub.total - sel.total), v = $('verdict');
        if (planOnline) v.textContent = '온라인 요금제 — 선택약정 미적용(공시지원 기준)';
        else if (diffT < 1000) v.textContent = '두 방식 차이 거의 없음';
        else if (sel.total < pub.total) v.textContent = '✔ 선택약정이 ' + won(diffT) + '원 이익 (' + (inp.n > 0 ? inp.n : 24) + '개월 총)';
        else v.textContent = '✔ 공시지원금이 ' + won(diffT) + '원 이익 (' + (inp.n > 0 ? inp.n : 24) + '개월 총)';

        // 방식/통신사/가입 활성 + 조건부 표시
        Array.prototype.forEach.call(document.querySelectorAll('.mbtn'), function (b) { var on = b.getAttribute('data-m') === method; b.className = 'mbtn rounded-xl border px-2 py-2.5 text-sm font-semibold ' + (on ? 'border-accent-500 bg-accent-50 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300' : 'border-gray-300 dark:border-white/15'); });
        Array.prototype.forEach.call(document.querySelectorAll('.carrier'), function (b) { var on = b.getAttribute('data-c') === carrier; b.className = 'carrier rounded-xl border px-2 py-2 text-sm font-semibold ' + (on ? 'border-accent-500 bg-accent-50 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300' : 'border-gray-300 dark:border-white/15'); });
        Array.prototype.forEach.call(document.querySelectorAll('.join'), function (b) { var on = b.getAttribute('data-j') === join; b.className = 'join rounded-xl border px-2 py-2 text-sm font-semibold ' + (on ? 'border-accent-500 bg-accent-50 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300' : 'border-gray-300 dark:border-white/15'); });
        Array.prototype.forEach.call(document.querySelectorAll('[data-pub]'), function (el) { el.style.display = method === 'pub' ? '' : 'none'; });
        Array.prototype.forEach.call(document.querySelectorAll('[data-sel]'), function (el) { el.style.display = method === 'sel' ? '' : 'none'; });
        Array.prototype.forEach.call(document.querySelectorAll('[data-mnp]'), function (el) { if (method === 'pub' && join === 'mnp') el.style.display = ''; else el.style.display = 'none'; });
      }

      $('device').addEventListener('change', function () { applyDevice(); calc(); });
      $('planSel').addEventListener('change', function () { applyPlan(); calc(); });
      ['price', 'subsidy', 'extraSub', 'switchSub', 'prepay', 'fee', 'etcDisc', 'addon'].forEach(function (id) { $(id).addEventListener('input', function () { fmtField($(id)); calc(); }); });
      Array.prototype.forEach.call(document.querySelectorAll('.carrier'), function (b) { b.addEventListener('click', function () { carrier = b.getAttribute('data-c'); fillPlans(); calc(); }); });
      Array.prototype.forEach.call(document.querySelectorAll('.mbtn'), function (b) { b.addEventListener('click', function () { method = b.getAttribute('data-m'); calc(); }); });
      Array.prototype.forEach.call(document.querySelectorAll('.join'), function (b) { b.addEventListener('click', function () { join = b.getAttribute('data-j'); calc(); }); });

      fillDevices(); applyDevice(); fillPlans(); fillTerms(); calc();
    })();
  </script>
</Layout>
