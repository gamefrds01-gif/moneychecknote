---
// 실업급여(구직급여) 계산기 2026 — 1일 지급액(평균임금 60%, 상·하한) × 소정급여일수.
import Layout from '../../layouts/Layout.astro';
import { UNEMPLOYMENT, SOURCE_META } from '../../data/rates';
import { breadcrumbSchema } from '../../lib/schema';
import SourceMeta from '../../components/SourceMeta.astro';

const client = { UNEMPLOYMENT };

const faqs = [
  { q: '실업급여는 아무나 받나요?', a: '고용보험 가입 기간이 이직 전 18개월 중 180일 이상이고, 자발적 퇴사가 아닌 비자발적 사유(계약만료·권고사직 등)로 실직해 적극적으로 재취업 활동을 해야 받을 수 있습니다. 자발적 퇴사는 원칙적으로 제외됩니다.' },
  { q: '1일 지급액은 어떻게 정해지나요?', a: `이직 전 3개월 평균임금의 60%입니다. 단 2026년 기준 1일 상한 ${UNEMPLOYMENT.dailyMax.toLocaleString('ko-KR')}원, 하한 ${UNEMPLOYMENT.dailyMin.toLocaleString('ko-KR')}원(최저임금 시급 ${UNEMPLOYMENT.minWageHour.toLocaleString('ko-KR')}원 × 8시간 × 80%)이 적용됩니다.` },
  { q: '며칠 동안 받나요?', a: '고용보험 가입기간과 나이(이직일 기준 50세 미만/이상·장애인)에 따라 120일에서 270일까지 소정급여일수가 정해집니다. 위 계산기에서 자동으로 반영됩니다.' },
  { q: '한 번에 얼마씩 들어오나요? (28일)', a: '구직급여는 4주(28일) 단위의 실업인정마다 지급됩니다. 실업인정을 받으면 그 기간(통상 28일분)이 계좌로 들어옵니다. 위 계산기에 28일분 지급액과 총 지급 횟수를 표시해 뒀습니다. 다만 신청 후 7일은 대기기간(무급)이라 1차 지급은 일수가 더 적을 수 있습니다.' },
];

const jsonLd = [
  breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }, { name: '실업급여 계산기', url: '/calc/unemployment/' }]),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: '실업급여 계산기 2026', applicationCategory: 'FinanceApplication', operatingSystem: 'All', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' }, url: 'https://money.pointchecknote.com/calc/unemployment/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout title="실업급여 계산기 2026 — 구직급여 예상 수급액·기간" description={`2026년 실업급여(구직급여)를 계산합니다. 평균임금 60%, 1일 상한 ${UNEMPLOYMENT.dailyMax.toLocaleString('ko-KR')}원·하한 ${UNEMPLOYMENT.dailyMin.toLocaleString('ko-KR')}원, 가입기간·나이별 소정급여일수 반영.`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl">
    <nav class="mb-4 text-sm text-gray-500" aria-label="위치"><a href="/" class="hover:text-accent-600">홈</a> › <a href="/calc/" class="hover:text-accent-600">계산기</a> › <span class="text-gray-700 dark:text-gray-300">실업급여</span></nav>
    <header class="reveal mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">실업급여 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">이직 전 평균임금·가입기간·나이를 넣으면 <strong>2026년 구직급여 예상 수급액과 일수</strong>를 계산합니다. 요율·상하한은 <strong>{UNEMPLOYMENT.asof}</strong> 기준.</p>
    </header>

    <section class="reveal mb-5 overflow-hidden rounded-3xl border border-accent-200 bg-gradient-to-br from-accent-50 to-white p-6 shadow-sm dark:border-accent-500/30 dark:from-accent-500/10 dark:to-surface-900">
      <p class="text-xs font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-300">예상 총 수급액</p>
      <p class="mt-1"><span id="total" class="tnum text-4xl font-extrabold sm:text-5xl">0</span> <span class="text-xl font-bold text-gray-500">원</span></p>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">1일 <span id="daily" class="tnum font-semibold">0</span> 원 <span id="rule" class="ml-1 inline-block rounded-full bg-accent-100 px-2 py-0.5 text-xs font-semibold text-accent-700 dark:bg-accent-500/20 dark:text-accent-300">평균임금 60%</span> × <span id="ndays" class="font-semibold">0</span>일 (약 <span id="months" class="font-semibold">0</span>개월)</p>
      <div class="mt-3 grid grid-cols-2 gap-3 border-t border-accent-200/60 pt-3 dark:border-white/10">
        <div>
          <p class="text-xs text-gray-500">28일분 (실업인정 주기 1회)</p>
          <p class="tnum text-xl font-extrabold sm:text-2xl"><span id="pay28">0</span> <span class="text-sm font-bold text-gray-500">원</span></p>
        </div>
        <div>
          <p class="text-xs text-gray-500">총 지급 횟수 (28일 기준)</p>
          <p class="tnum text-xl font-extrabold sm:text-2xl"><span id="cycles">0</span> <span class="text-sm font-bold text-gray-500">회</span></p>
        </div>
      </div>
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 border-t border-accent-200/60 pt-3 text-xs text-gray-500 dark:border-white/10">
        <span>1일 <strong>상한 {UNEMPLOYMENT.dailyMax.toLocaleString('ko-KR')}원</strong> <span class="text-gray-400">(2025년 66,000원→2026 인상)</span></span>
        <span>1일 <strong>하한 {UNEMPLOYMENT.dailyMin.toLocaleString('ko-KR')}원</strong> <span class="text-gray-400">= 최저시급 {UNEMPLOYMENT.minWageHour.toLocaleString('ko-KR')}원 × 80% × 8h</span></span>
      </p>
    </section>

    <section class="reveal rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900 sm:p-6">
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="sm:col-span-3">
          <label for="avg" class="mb-1 block text-sm font-semibold">이직 전 3개월 월평균 급여 (원)</label>
          <input id="avg" type="text" inputmode="numeric" autocomplete="off" value="3,000,000" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-lg tnum dark:border-white/15 dark:bg-surface-800" />
          <p class="mt-1 text-xs text-gray-500">세전 평균 급여. 1일 평균임금으로 환산해 60% 적용.</p>
        </div>
        <div>
          <label for="yy" class="mb-1 block text-sm font-semibold">고용보험 가입기간 (년)</label>
          <input id="yy" type="text" inputmode="numeric" autocomplete="off" value="3" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 tnum dark:border-white/15 dark:bg-surface-800" />
        </div>
        <div>
          <label for="age" class="mb-1 block text-sm font-semibold">이직일 나이 (만)</label>
          <input id="age" type="text" inputmode="numeric" autocomplete="off" value="35" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 tnum dark:border-white/15 dark:bg-surface-800" />
        </div>
        <div class="flex items-end">
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-gray-200 px-3 py-2.5 text-sm dark:border-white/10"><input id="disabled" type="checkbox" class="h-4 w-4" /> <span>장애인</span></label>
        </div>
      </div>
    </section>

    <SourceMeta meta={SOURCE_META.unemployment} asof={UNEMPLOYMENT.asof} />

    <section class="reveal mt-8">
      <h2 class="mb-3 text-xl font-bold tracking-tight">자주 묻는 질문</h2>
      <div class="space-y-3">{faqs.map((f) => (<details class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-900"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{f.a}</p></details>))}</div>
      <p class="mt-4 text-xs text-gray-500">2026년 기준(확인일 {UNEMPLOYMENT.asof}): 1일 상한 {UNEMPLOYMENT.dailyMax.toLocaleString('ko-KR')}원·하한 {UNEMPLOYMENT.dailyMin.toLocaleString('ko-KR')}원, 최저임금 시급 {UNEMPLOYMENT.minWageHour.toLocaleString('ko-KR')}원. 추정값이며 실제 수급 여부·금액은 고용센터 심사로 결정됩니다.</p>
    </section>
  </div>

  <script is:inline define:vars={{ client }}>
    (function () {
      var U = client.UNEMPLOYMENT;
      var $ = function (id) { return document.getElementById(id); };
      var digits = function (v) { return parseInt(String(v).replace(/[^0-9]/g, ''), 10) || 0; };
      var won = function (n) { return Math.round(n).toLocaleString('ko-KR'); };
      function fmtField(el) { var d = digits(el.value); el.value = d ? d.toLocaleString('ko-KR') : ''; }
      function durationDays(years, age, disabled) {
        var over = (age >= 50) || disabled;
        for (var i = 0; i < U.durations.length; i++) { if (years < U.durations[i][0]) return over ? U.durations[i][2] : U.durations[i][1]; }
        return over ? 270 : 240;
      }
      function calc() {
        var avg = digits($('avg').value);
        var years = digits($('yy').value);
        var age = digits($('age').value);
        var disabled = $('disabled').checked;
        var dailyAvg = (avg * 3) / 91.25; // 1일 평균임금
        var daily = dailyAvg * U.rate;
        var rule = '평균임금 60%';
        if (daily > U.dailyMax) { daily = U.dailyMax; rule = '상한 적용'; }
        else if (daily < U.dailyMin) { daily = U.dailyMin; rule = '하한 적용'; }
        var n = durationDays(years, age, disabled);
        var total = daily * n;
        $('rule').textContent = rule;
        $('daily').textContent = won(daily);
        $('ndays').textContent = n.toLocaleString('ko-KR');
        $('months').textContent = (n / 30).toFixed(1);
        $('total').textContent = won(total);
        var cyc = U.payCycleDays || 28;
        $('pay28').textContent = won(daily * cyc);
        $('cycles').textContent = Math.ceil(n / cyc).toLocaleString('ko-KR');
      }
      $('avg').addEventListener('input', function () { fmtField($('avg')); calc(); });
      ['yy', 'age'].forEach(function (id) { $(id).addEventListener('input', calc); });
      $('disabled').addEventListener('change', calc);
      calc();
    })();
  </script>
</Layout>
