---
// 부가가치세 계산기 — 공급가액 기준 / 합계(공급대가) 기준 양방향. 일반과세 10%.
import Layout from '../../layouts/Layout.astro';
import { SOURCE_META, RATES_ASOF } from '../../data/rates';
import { breadcrumbSchema } from '../../lib/schema';
import SourceMeta from '../../components/SourceMeta.astro';

const faqs = [
  { q: '부가세는 어떻게 계산하나요?', a: '일반과세 사업자의 부가가치세는 공급가액의 10%입니다. 공급가액이 100만 원이면 부가세는 10만 원, 합계(공급대가)는 110만 원입니다. 반대로 합계에서 부가세를 뽑을 땐 합계 ÷ 11 입니다.' },
  { q: '합계 금액에서 부가세만 빼려면요?', a: '부가세 포함 합계를 11로 나누면 부가세, 11로 나눈 값에 10을 곱하면 공급가액입니다. 예: 110,000원 → 부가세 10,000원, 공급가액 100,000원. 아래에서 "합계 기준"을 선택하세요.' },
  { q: '간이과세자도 10%인가요?', a: '아니요. 간이과세자는 업종별 부가가치율(15~40%)을 적용해 실제 부담이 더 낮고, 세금계산서 발급·매입세액 공제 방식도 다릅니다. 이 계산기는 일반과세(10%) 기준입니다.' },
  { q: '부가세 신고는 언제 하나요?', a: '법인은 분기별, 개인 일반과세자는 1월·7월(반기) 확정신고합니다. 간이과세자는 다음 해 1월에 연 1회 신고합니다. 정확한 일정·세액은 홈택스에서 확인하세요.' },
];

const jsonLd = [
  breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }, { name: '부가세 계산기', url: '/calc/vat/' }]),
  { '@context': 'https://schema.org', '@type': 'WebApplication', name: '부가가치세 계산기', applicationCategory: 'FinanceApplication', operatingSystem: 'All', offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' }, url: 'https://money.pointchecknote.com/calc/vat/' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout title="부가세 계산기 — 공급가액·합계에서 부가가치세 계산" description="공급가액 또는 부가세 포함 합계를 넣으면 부가가치세(10%)와 공급가액·합계를 양방향으로 계산합니다. 일반과세 기준." jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl">
    <nav class="mb-4 text-sm text-gray-500" aria-label="위치"><a href="/" class="hover:text-accent-600">홈</a> › <a href="/calc/" class="hover:text-accent-600">계산기</a> › <span class="text-gray-700 dark:text-gray-300">부가세</span></nav>
    <header class="reveal mb-6">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">부가세 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">공급가액 또는 합계 금액을 넣으면 <strong>부가가치세(10%)</strong>를 양방향으로 계산합니다. 일반과세 기준.</p>
    </header>

    <section class="reveal mb-5 grid gap-4 sm:grid-cols-3">
      <div class="rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900"><p class="text-xs text-gray-500">공급가액</p><p class="mt-1 tnum text-2xl font-extrabold"><span id="supply">0</span></p></div>
      <div class="overflow-hidden rounded-3xl border border-accent-200 bg-gradient-to-br from-accent-50 to-white p-5 dark:border-accent-500/30 dark:from-accent-500/10 dark:to-surface-900"><p class="text-xs font-semibold text-accent-700 dark:text-accent-300">부가세 (10%)</p><p class="mt-1 tnum text-2xl font-extrabold"><span id="vat">0</span></p></div>
      <div class="rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900"><p class="text-xs text-gray-500">합계 (공급대가)</p><p class="mt-1 tnum text-2xl font-extrabold"><span id="sum">0</span></p></div>
    </section>

    <section class="reveal rounded-3xl border border-gray-200 bg-white p-5 dark:border-white/10 dark:bg-surface-900 sm:p-6">
      <p class="mb-2 text-sm font-semibold">입력 기준</p>
      <div id="modes" class="mb-4 grid grid-cols-2 gap-2">
        <button type="button" data-m="supply" class="mode rounded-xl border px-2 py-2 text-sm font-semibold">공급가액 기준 (부가세 별도)</button>
        <button type="button" data-m="sum" class="mode rounded-xl border px-2 py-2 text-sm font-semibold">합계 기준 (부가세 포함)</button>
      </div>
      <label for="amount" class="mb-1 block text-sm font-semibold" id="amount-label">금액 (원)</label>
      <input id="amount" type="text" inputmode="numeric" autocomplete="off" value="1,000,000" class="w-full rounded-xl border border-gray-300 bg-white px-3 py-2 text-lg tnum dark:border-white/15 dark:bg-surface-800" />
    </section>

    <SourceMeta meta={SOURCE_META.income} asof={RATES_ASOF} />

    <section class="reveal mt-8">
      <h2 class="mb-3 text-xl font-bold tracking-tight">자주 묻는 질문</h2>
      <div class="space-y-3">{faqs.map((f) => (<details class="rounded-xl border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-surface-900"><summary class="cursor-pointer font-semibold">{f.q}</summary><p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{f.a}</p></details>))}</div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var digits = function (v) { return parseInt(String(v).replace(/[^0-9]/g, ''), 10) || 0; };
      var won = function (n) { return Math.round(n).toLocaleString('ko-KR'); };
      var mode = 'supply';
      function fmtField(el) { var d = digits(el.value); el.value = d ? d.toLocaleString('ko-KR') : ''; }
      function calc() {
        var amt = digits($('amount').value), supply, vat, sum;
        if (mode === 'supply') { supply = amt; vat = amt * 0.1; sum = amt + vat; }
        else { sum = amt; supply = amt / 1.1; vat = sum - supply; }
        $('supply').textContent = won(supply);
        $('vat').textContent = won(vat);
        $('sum').textContent = won(sum);
        Array.prototype.forEach.call(document.querySelectorAll('.mode'), function (b) {
          var on = b.getAttribute('data-m') === mode;
          b.className = 'mode rounded-xl border px-2 py-2 text-sm font-semibold ' + (on ? 'border-accent-500 bg-accent-50 text-accent-700 dark:bg-accent-500/15 dark:text-accent-300' : 'border-gray-300 dark:border-white/15');
        });
        $('amount-label').textContent = mode === 'supply' ? '공급가액 (원)' : '합계 금액 (부가세 포함, 원)';
      }
      $('amount').addEventListener('input', function () { fmtField($('amount')); calc(); });
      Array.prototype.forEach.call(document.querySelectorAll('.mode'), function (b) { b.addEventListener('click', function () { mode = b.getAttribute('data-m'); calc(); }); });
      calc();
    })();
  </script>
</Layout>
