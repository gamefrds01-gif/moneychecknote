---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../lib/schema';

const calculators = [
  { href: '/calc/salary/', name: '연봉 실수령액 계산기', desc: '2026 4대보험·소득세 반영 세후 월급', live: true },
  { href: '/calc/loan/', name: '대출 원리금 계산기', desc: '원리금균등·원금균등 월 상환액·총이자', live: true },
  { href: '/calc/severance/', name: '퇴직금 계산기', desc: '평균임금 기준 예상 퇴직금', live: true },
  { href: '/calc/unemployment/', name: '실업급여 계산기', desc: '2026 구직급여 예상 수급액·일수', live: true },
];

const jsonLd = breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }]);
---

<Layout title="돈 계산기 모음 — 연봉 실수령액·퇴직금·대출·실업급여" description="연봉 실수령액, 대출 원리금, 퇴직금, 실업급여를 한 곳에서 계산하세요. 2026 최신 요율·세율 기준, 계산 근거와 확인일 공개." jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <header class="reveal mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">돈 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">내 돈이 얼마인지 바로 계산합니다. 최신 요율·세율 기준으로 확인일을 함께 표시해요.</p>
    </header>
    <div class="grid gap-4 sm:grid-cols-2">
      {calculators.map((c) => (
        <a href={c.href} class="reveal block rounded-2xl border border-gray-200 bg-white p-5 transition-colors hover:border-accent-500 dark:border-white/10 dark:bg-surface-900">
          <h2 class="text-lg font-bold">{c.name}</h2>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{c.desc}</p>
        </a>
      ))}
    </div>
    <p class="reveal mt-6 text-sm text-gray-500">국민연금 예상수령액은 가입이력이 필요해 <a href="/posts/2026-09-06-국민연금-예상수령액-조회/" class="underline">공식 조회 방법 안내</a>로 대신합니다.</p>
  </div>
</Layout>
