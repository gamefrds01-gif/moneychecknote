---
import Layout from '../../layouts/Layout.astro';
import { breadcrumbSchema } from '../../lib/schema';

const calculators = [
  { href: '/calc/salary/', name: '연봉 실수령액 계산기', desc: '2026 4대보험·소득세 반영 세후 월급 + 연봉별 빠른표', live: true },
  { href: '/calc/hourly/', name: '시급·주휴수당 계산기', desc: '근로기준법 주휴수당·주급·월급 환산(2026 최저 10,320)', live: true },
  { href: '/calc/loan/', name: '대출 계산기', desc: '원리금균등·원금균등·만기일시 + 거치·상환표·DSR', live: true },
  { href: '/calc/severance/', name: '퇴직금 계산기', desc: '평균임금 기준 + 퇴직소득세 세후 실수령', live: true },
  { href: '/calc/unemployment/', name: '실업급여 계산기', desc: '2026 구직급여 예상액·일수 + 28일분 지급', live: true },
  { href: '/calc/cartax/', name: '자동차세 계산기', desc: '배기량·차령 경감 + 1월 연납 할인', live: true },
  { href: '/calc/electricity/', name: '전기요금 계산기', desc: '주택용 저압 누진 3구간 예상 청구액', live: true },
  { href: '/calc/income-tax/', name: '종합소득세 계산기', desc: '과세표준 누진세율 + 지방소득세', live: true },
  { href: '/calc/vat/', name: '부가세 계산기', desc: '공급가액·합계 양방향 부가가치세 10%', live: true },
];

const jsonLd = breadcrumbSchema([{ name: '홈', url: '/' }, { name: '계산기', url: '/calc/' }]);
---

<Layout title="돈 계산기 모음 — 연봉 실수령액·퇴직금·대출·실업급여" description="연봉 실수령액, 대출 원리금, 퇴직금, 실업급여를 한 곳에서 계산하세요. 2026 최신 요율·세율 기준, 계산 근거와 확인일 공개." jsonLd={jsonLd}>
  <div class="mx-auto max-w-4xl">
    <header class="reveal mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">돈 계산기</h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">내 돈이 얼마인지 바로 계산합니다. 최신 요율·세율 기준으로 확인일을 함께 표시해요.</p>
    </header>
    <div class="grid gap-4 sm:grid-cols-2">
      {calculators.map((c) => (
        <a href={c.href} class="reveal block rounded-2xl border border-gray-200 bg-white p-5 transition-colors hover:border-accent-500 dark:border-white/10 dark:bg-surface-900">
          <h2 class="text-lg font-bold">{c.name}</h2>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{c.desc}</p>
        </a>
      ))}
    </div>
    <p class="reveal mt-6 text-sm text-gray-500">국민연금 예상수령액은 가입이력이 필요해 <a href="/posts/2026-09-06-국민연금-예상수령액-조회/" class="underline">공식 조회 방법 안내</a>로 대신합니다.</p>
  </div>
</Layout>
